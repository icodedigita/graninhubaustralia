# Site
NEXT_PUBLIC_SITE_NAME="Grain Hub Australia"
NEXT_PUBLIC_SITE_URL=https://grainhubaustralia.com.au

# SEO / meta tags (all optional — sensible defaults derived from the values above)
NEXT_PUBLIC_SEO_TITLE="Grain Hub Australia | Premium Australian Pulses, Lentils & Grains"
NEXT_PUBLIC_SEO_DESCRIPTION="Grain Hub Australia — your trusted partner for high-quality, non-GMO pulses, lentils and grains. Farm-direct exports to the world since 2016."
NEXT_PUBLIC_SEO_OG_TITLE="Grain Hub Australia"
NEXT_PUBLIC_SEO_OG_DESCRIPTION="Premium Australian pulses, lentils & grains for global palates."
NEXT_PUBLIC_SEO_OG_IMAGE=/images/lentils.webp
NEXT_PUBLIC_TWITTER_HANDLE=
# Comma-separated
NEXT_PUBLIC_SEO_KEYWORDS="Australian pulses,lentils export,chickpeas,mung beans,yellow split peas,grain hub australia,grain export Australia"
# Search engine verification (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Set to "true" only when ready to go live — otherwise robots.txt blocks all crawlers
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact
NEXT_PUBLIC_CONTACT_EMAIL=info@grainhubaustralia.com.au
NEXT_PUBLIC_PHONE_DISPLAY="+61 461 52 7765"
# Digits only, with country code, no + or spaces (used for wa.me / tel: links)
NEXT_PUBLIC_WHATSAPP_NUMBER=61461527765
NEXT_PUBLIC_ADDRESS="Melbourne, Victoria, Australia"
NEXT_PUBLIC_BUSINESS_HOURS="Mon – Fri, 9am – 6pm AEST"

# Social media (leave blank to hide the icon/link)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_TIKTOK_URL=

# Database
DATABASE_URL=

# SMTP (used to send contact/inquiry form submissions).
# For `wrangler dev`, SMTP_HOST/PORT/SECURE/FROM_NAME/ADMIN_EMAIL come from
# the "vars" block in wrangler.jsonc — this file is only needed for `next dev`
# without wrangler, or to override those defaults locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# "true" for implicit TLS (port 465), "false" for STARTTLS (port 587)
SMTP_SECURE=false
# Gmail/Google Workspace: full email address + a 16-char App Password
# (https://myaccount.google.com/apppasswords) — not your normal password.
SMTP_USER=
SMTP_PASSWORD=
# Optional — defaults to SMTP_USER
SMTP_FROM_EMAIL=info@grainhubaustralia.com.au
SMTP_FROM_NAME="Grain Hub Australia"

# Inbox that receives a copy of every form submission
ADMIN_EMAIL=info@grainhubaustralia.com.au
